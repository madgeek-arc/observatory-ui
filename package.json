{
  "name": "observatory-ui",
  "version": "4.4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:beta": "ng build --configuration beta",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --reporters=dots --reporters=junit",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:scripts:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/scripts-junit.xml \"scripts/**/*.test.mjs\"",
    "docx:figures": "node scripts/renumber-docx-figures.mjs",
    "docx:figures:check": "node scripts/renumber-docx-figures.mjs --check",
    "docx:tags:check": "node scripts/check-docx-tags.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^22.2.4",
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@highcharts/map-collection": "^2.3.2",
    "@ng-select/ng-select": "^24.2.1",
    "@sentry/angular": "~10.76.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bitset": "^5.1.1",
    "docxtemplater": "~3.1.0",
    "docxtemplater-image-module": "3.1.0",
    "file-saver": "^2.0.5",
    "highcharts": "^11.3.0",
    "highcharts-angular": "^4.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lodash": "^4.17.23",
    "ng-recaptcha-2": "^22.0.1",
    "ngx-matomo-client": "^10.0.0",
    "pdfmake": "^0.2.7",
    "pizzip": "^3.2.0",
    "rxjs": "~7.8.2",
    "seedrandom": "^3.0.5",
    "tslib": "^2.3.0",
    "uikit": "3.16.24",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@types/jasmine": "~3.8.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/uikit": "^3.23.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "karma-junit-reporter": "~2.0.1",
    "less": "^4.3.0",
